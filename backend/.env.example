# Required. There is no built-in fallback — the API refuses to start without it.
DATABASE_URL=mysql+pymysql://buildbrief_user:Your-password@raspberrypi.local:3306/buildbrief

# Where the API listens. Keep this on loopback unless there is an authenticating
# proxy in front of it — the API itself has no access control.
HOST=127.0.0.1
PORT=8001

LM_STUDIO_URL=http://localhost:1234
OLLAMA_URL=http://localhost:11434
